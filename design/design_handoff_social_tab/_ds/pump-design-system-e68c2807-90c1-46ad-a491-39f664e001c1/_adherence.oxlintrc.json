{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/feedback/**",
              "components/logging/**",
              "components/navigation/**",
              "ui_kits/pump/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:confidence|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceDots> doesn't accept that prop. Declared props: confidence, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashedAdd'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|height|style|key|ref|className|style|children)$/]",
        "message": "<DashedAdd> doesn't accept that prop. Declared props: label, onClick, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrubberDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|date|logged|key|ref|className|style|children)$/]",
        "message": "<ScrubberDay> doesn't accept that prop. Declared props: letter, date, logged."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockedCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|overline|meta|metaOverline|variant|progress|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DockedCTA> doesn't accept that prop. Declared props: label, overline, meta, metaOverline, variant, progress, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockedCTA'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|draft|destructive)$/]",
        "message": "<DockedCTA> variant must be one of 'primary' | 'draft' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|glyph|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action, glyph, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|equipment|pr|oneRm|delta|deltaDirection|setsDone|totalSets|lastNote|collapsed|onToggleCollapse|onOverflow|hasRIR|children|style|key|ref|className|style|children)$/]",
        "message": "<ExerciseCard> doesn't accept that prop. Declared props: index, name, equipment, pr, oneRm, delta, deltaDirection, setsDone, totalSets, lastNote, collapsed, onToggleCollapse, onOverflow, hasRIR, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseCard'] > JSXAttribute[name.name='deltaDirection'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<ExerciseCard> deltaDirection must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: label, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPIBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|denominator|delta|direction|variant|align|style|key|ref|className|style|children)$/]",
        "message": "<KPIBlock> doesn't accept that prop. Declared props: label, value, denominator, delta, direction, variant, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPIBlock'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<KPIBlock> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPIBlock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|hero|compact)$/]",
        "message": "<KPIBlock> variant must be one of 'inline' | 'hero' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPIBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<KPIBlock> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|overline|showMark|onBack|right|style|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: title, overline, showMark, onBack, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlateBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:targetKg|barKg|showChips|style|key|ref|className|style|children)$/]",
        "message": "<PlateBar> doesn't accept that prop. Declared props: targetKg, barKg, showChips, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PRMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|style|key|ref|className|style|children)$/]",
        "message": "<PRMark> doesn't accept that prop. Declared props: children, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RestTimerPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:seconds|total|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RestTimerPill> doesn't accept that prop. Declared props: seconds, total, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|meta|accent|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, meta, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|type|kg|reps|rir|prevKg|prevReps|prevRir|state|isPR|hasRIR|onTypeClick|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SetRow> doesn't accept that prop. Declared props: index, type, kg, reps, rir, prevKg, prevReps, prevRir, state, isPR, hasRIR, onTypeClick, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|active|done)$/]",
        "message": "<SetRow> state must be one of 'pending' | 'active' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetTypeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SetTypeChip> doesn't accept that prop. Declared props: type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|direction|key|ref|className|style|children)$/]",
        "message": "<TickerItem> doesn't accept that prop. Declared props: label, value, direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerItem'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<TickerItem> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrendValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|direction|size|bold|showArrow|style|key|ref|className|style|children)$/]",
        "message": "<TrendValue> doesn't accept that prop. Declared props: value, direction, size, bold, showArrow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrendValue'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<TrendValue> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|done|today|height|style|key|ref|className|style|children)$/]",
        "message": "<WeekBars> doesn't accept that prop. Declared props: data, labels, done, today, height, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
