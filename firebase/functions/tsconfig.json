{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test", "*.ts"]
}
